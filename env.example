# Copy this file to ".env" and fill in your real details.
# ".env" itself should NEVER be committed to git/GitHub - it's already listed in .gitignore.
# This file (.env.example) contains no real data, so it's safe to commit as a template.

CANDIDATE_FIRST_NAME=YOUR_FIRST_NAME
CANDIDATE_LAST_NAME=YOUR_LAST_NAME
CANDIDATE_FULL_NAME=YOUR_FULL_NAME
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PHONE=+44 0000 000000
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/yourprofile
CANDIDATE_GITHUB=https://www.github.com/yourprofile

# Absolute path to your CV file (PDF recommended)
CV_PATH=/absolute/path/to/your_CV.pdf
